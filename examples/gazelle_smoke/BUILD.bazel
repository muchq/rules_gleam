load("@bazel_gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("@rules_gleam//gleam:defs.bzl", "gleam_package")

# Wires rules_gleam's own Gazelle language extension into this project's `bazel run //:gazelle`.
gazelle_binary(
    name = "gazelle_bin",
    languages = ["@rules_gleam//gleam_gazelle"],
)

gazelle(
    name = "gazelle",
    gazelle = "gazelle_bin",
)

# Generated by `bazel run //:gazelle` from gleam.toml + src/**/*.gleam + test/**/*.gleam --
# re-run gazelle after adding/removing .gleam files to keep this in sync.
gleam_package(
    name = "gazelle_smoke",
    srcs = glob(["src/**/*.gleam"]),
    gleam_toml = "gleam.toml",
    test_deps = ["@gleam_packages//:gleeunit"],
    test_srcs = glob(["test/**/*.gleam"]),
    deps = ["@gleam_packages//:gleam_stdlib"],
)
