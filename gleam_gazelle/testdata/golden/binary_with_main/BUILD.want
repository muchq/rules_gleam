gleam_package(
    name = "my_bin",
    srcs = glob(
        [
            "src/**/*.erl",
            "src/**/*.gleam",
            "src/**/*.mjs",
        ],
        allow_empty = True,
    ),
    data = glob(
        [
            "src/**/*.hrl",
            "include/**/*.hrl",
            "priv/**",
        ],
        allow_empty = True,
    ),
    entry_module = "main",
    gleam_toml = "gleam.toml",
)
