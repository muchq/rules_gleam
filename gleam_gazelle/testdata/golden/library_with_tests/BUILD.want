gleam_package(
    name = "my_lib",
    srcs = glob(
        [
            "src/**/*.erl",
            "src/**/*.gleam",
            "src/**/*.mjs",
        ],
        allow_empty = True,
    ),
    data = glob(
        [
            "src/**/*.hrl",
            "include/**/*.hrl",
            "priv/**",
        ],
        allow_empty = True,
    ),
    gleam_toml = "gleam.toml",
    test_deps = ["@gleam_packages//:gleeunit"],
    test_srcs = glob(
        [
            "test/**/*.gleam",
            "test/**/*.erl",
            "test/**/*.mjs",
        ],
        allow_empty = True,
    ),
    deps = ["@gleam_packages//:gleam_stdlib"],
)
